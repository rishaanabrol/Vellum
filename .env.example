# Google Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# LLM model identifier (Gemini Flash recommended, e.g., gemini-3.5-flash-lite or gemini-3.8-flash)
LLM_MODEL=gemini-3.5-flash-lite

# Embedding model identifier
EMBEDDING_MODEL=gemini-embedding-001

# Chunking defaults
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval settings
TOP_K=5
CANDIDATE_K=8
MIN_RELEVANCE=0.65

# Storage directories
CHROMA_PERSIST_DIR=./storage/chroma
DOCUMENTS_DIR=./storage/docs
